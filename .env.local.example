NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_PUBLIC_ACCESS_TOKEN=your-public-storefront-access-token
SHOPIFY_STOREFRONT_PRIVATE_ACCESS_TOKEN=your-private-storefront-access-token

NEXT_PUBLIC_SHOPIFY_STOREFRONT_VERSION=2026-07

# Shopify Admin MCP (new - from Dev Dashboard at dev.shopify.com)
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=shpss_your-client-secret

# Public URL of this app. Used as the Shopify webhook callback base URL.
# e.g. https://vialityhealth.com
SHOPIFY_APP_URL=

# Alternative app URL used for the cart checkout button when set.
# The button will direct to `${NEXT_PUBLIC_SHOPIFY_APP_URL_ALTERNATIVE}/cart?cartId=<cart id>`.
NEXT_PUBLIC_SHOPIFY_APP_URL_ALTERNATIVE=

# Secret used to guard manual revalidation and webhook registration calls
# (sent via the "x-revalidate-secret" header).
REVALIDATE_SECRET=

# Free shipping discount id (numeric part of the /discounts/{id} admin URL)
SHOPIFY_FREE_SHIPPING_DISCOUNT_ID=1356928319628