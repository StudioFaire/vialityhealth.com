{
  "name": "vialityhealth.com",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbopack -p 3000",
    "doctor": "react-doctor",
    "fallow:audit": "fallow audit --base origin/main",
    "fallow": "fallow dead-code",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,md}\"",
    "format": "oxfmt --write \"**/*.{ts,tsx,md}\"",
    "hutch:dev": "cd desktop && hutch install && hutch electrobun sync && hutch run dev",
    "knip": "knip",
    "lint": "oxlint -c .oxlintrc.json",
    "prepare": "husky",
    "skott": "skott --displayMode=raw --showCircularDependencies --exitCodeOnCircularDependencies=1 --no-trackTypeOnlyDependencies --ignorePattern \"**/routeTree.gen.ts\" --ignorePattern \"**/*-stub.js\" --fileExtensions=.ts,.tsx,.js,.jsx",
    "start": "next start",
    "taze:major": "taze major -r",
    "taze": "taze -r",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@next/third-parties": "^16.3.4",
    "@shopify/storefront-api-client": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-social-icons": "^6.26.0",
    "resend": "^6.26.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.4.1",
    "@types/react-dom": "^19.2.7",
    "@types/react": "^19.2.18",
    "@vitest/ui": "^4.1.11",
    "fallow": "^3.21.0",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "react-doctor": "^0.9.12",
    "skott": "^0.35.11",
    "tailwindcss": "^4.3.3",
    "taze": "^21.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}