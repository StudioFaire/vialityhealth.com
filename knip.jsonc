{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "taze.config.ts",
    "desktop/**",
    "**/intlayer.config.ts",
    "**/electrobun.config.ts",
    "**/hutch.config.ts"
  ],
  "ignoreDependencies": [
    "cloudflare",
    "@vitest/ui",
    "vitest",
    "tailwindcss",
    "@fontsource-variable/geist",
    "tw-animate-css"
  ],
  "workspaces": {
    "apps/*": {
      "entry": [
        "app/router.tsx",
        "app/server-entry.ts",
        "app/routes/**/*.{ts,tsx}",
        "app/orpc/**/*.{ts,tsx}"
      ],
      "project": ["**/*.{ts,tsx,js}"],
      "ignore": ["**/routeTree.gen.ts", "**/*.content.ts"]
    },
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["**/*.content.ts"]
    }
  }
}
